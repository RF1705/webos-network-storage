# Install as profiles/games.conf, remove comments, and set mode 0600.
# For NFSv4, REMOTE_PATH is the path below the server's NFSv4 pseudoroot.
DISPLAY_NAME=Games (NFSv4)
PROTOCOL=nfs
SERVER=192.0.2.10
REMOTE_PATH=/games
MOUNT_NAME=games
READ_ONLY=true
AUTO_CONNECT=true
APP_IDS=org.scummvm.scummvm com.retroarch
NFS_VERSION=4
